<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#142B4B" />
  <SolidColorBrush x:Key="Muted" Color="#526785" />
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="#F3F5FA" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Foreground" Value="#1F50CC" />
    <Setter Property="Background" Value="#EAF0FD" />
    <Setter Property="BorderBrush" Value="#CBD8F0" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
</ResourceDictionary>
