<Window x:Class="StarMap.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:local="clr-namespace:StarMap.Desktop"
        Title="星图 · WPF 混合迁移" Width="1080" Height="760" MinWidth="760" MinHeight="560"
        Closing="OnClosing" Loaded="OnLoaded">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="White" Padding="8,24">
      <StackPanel>
        <TextBlock Text="星图" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,26" />
        <Button x:Name="HomeNavigation" Content="主页" Click="OnHomeNavigation" Padding="4,10" Margin="0,0,0,10" />
        <Button x:Name="GalleryNavigation" Content="地图资源" Click="OnGalleryNavigation" Padding="4,10" />
      </StackPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="28,18,28,0">
        <Button x:Name="OpenResourcesButton" DockPanel.Dock="Right" Content="选择资源目录" Click="OnOpenResources" AutomationProperties.Name="选择资源目录" />
        <TextBlock x:Name="ResourcePathLabel" Text="尚未选择资源目录" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
      </DockPanel>
      <local:RuntimePage x:Name="HomePage" Grid.Row="1" OpenFrameRequested="OnOpenFrame" />
      <Grid x:Name="GalleryPage" Grid.Row="1" Margin="28,16,28,20" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="地图资源" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="浏览本机图包中的地图与楼层" Foreground="{StaticResource Muted}" Margin="0,6,20,0" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新本机" Click="OnRefresh" />
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" />
        <ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <Label Content="赛季与模式" Target="{Binding ElementName=ContextSelector}" Padding="0,0,0,6" />
        <ComboBox x:Name="ContextSelector" ItemsSource="{Binding Contexts}" SelectedItem="{Binding Context}"
                  DisplayMemberPath="Label" AutomationProperties.Name="赛季与模式" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <Label Content="图包来源" Target="{Binding ElementName=ProfileSelector}" Padding="0,0,0,6" />
        <ComboBox x:Name="ProfileSelector" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}"
                  DisplayMemberPath="Name" AutomationProperties.Name="图包来源" />
      </StackPanel>
      <StackPanel Grid.Column="4">
        <Label Content="楼层" Target="{Binding ElementName=FloorSelector}" Padding="0,0,0,6" />
        <ComboBox x:Name="FloorSelector" ItemsSource="{Binding Floors}" SelectedItem="{Binding Floor}"
                  DisplayMemberPath="Name" AutomationProperties.Name="楼层" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                 AutomationProperties.Name="搜索地图名称或编号" ToolTip="搜索地图名称或编号" />
        <ListBox x:Name="MapList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="地图与楼层列表">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate><StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Availability}" Foreground="#A52C2C" />
            </StackPanel></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Text="{Binding SelectedDescription}" Foreground="{StaticResource Muted}" Margin="0,6,0,16" />
          <Grid Grid.Row="2">
            <Image x:Name="MapPreview" Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="所选地图预览" />
            <TextBlock Text="{Binding PreviewStatus}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" TextAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <ProgressBar IsIndeterminate="{Binding Busy}" Height="3" Margin="0,0,0,10" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
