/* One light palette across native chrome, pages and dialogs. */
QWidget { background-color: #ffffff; color: #202124; font-family: "Microsoft YaHei UI"; font-size: 14px; }
QLineEdit { border: 1px solid #9ca3af; border-radius: 4px; padding: 7px; }
QLineEdit:focus { border-color: #2563eb; }
QPushButton { background-color: #f3f4f6; color: #202124; border: 1px solid #9ca3af; border-radius: 4px; padding: 6px 14px; min-height: 22px; }
QPushButton:hover { background-color: #e5e7eb; }
QPushButton:default, QPushButton#qt_wizard_commit { background-color: #2563eb; color: #ffffff; border-color: #2563eb; }
QPushButton:disabled { background-color: #f3f4f6; color: #6b7280; border-color: #d1d5db; }
QProgressBar { border: 1px solid #d1d5db; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background-color: #2563eb; }
QWizardPage QRadioButton:disabled, QWizardPage QCheckBox:disabled { color: #9ca3af; }
/* Chinese link labels need more width than their short English originals. */
QLabel#SelectAll, QLabel#SelectNone, QLabel#Default { min-width: 32px; }
QLabel#LocationError { color: #b91c1c; }
