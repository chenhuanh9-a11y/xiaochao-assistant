 <class>TrialDataPage</class>
 <widget class="QWidget" name="TrialDataPage">
  <property name="windowTitle"><string>测试资料处理</string></property>
  <layout class="QVBoxLayout" name="layout">
   <item><widget class="QLabel" name="scopeLabel">
    <property name="wordWrap"><bool>true</bool></property>
    <property name="text"><string>以下选择仅在卸载本测试安装时生效。默认保留资料。更新操作不清理资料。</string></property>
   </widget></item>
