<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>..\..\src\StarMap.App\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\StarMap.App\Platform\WindowsGraphicsCapture*.cs" Link="Production\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\StarMap.App\Platform\WindowsClientCapture.cs" Link="Production\WindowsClientCapture.cs" />
    <Compile Include="..\..\src\StarMap.App\Platform\Win32CaptureNative.cs" Link="Production\Win32CaptureNative.cs" />
  </ItemGroup>
</Project>
