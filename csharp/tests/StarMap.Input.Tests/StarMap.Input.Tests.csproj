<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>..\..\src\StarMap.App\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StarMap.Core\StarMap.Core.csproj" />
    <Compile Include="..\..\src\StarMap.App\Platform\WindowsGlobalInput*.cs" Link="Production\%(Filename)%(Extension)" />
    <None Include="python-oracle.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
