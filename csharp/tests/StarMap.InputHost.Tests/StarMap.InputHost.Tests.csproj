<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\StarMap.Core\StarMap.Core.csproj" />
    <Compile Include="..\..\src\StarMap.App\Platform\WindowsGlobalInput*.cs" Link="Production\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\StarMap.App\Platform\WpfGlobalInputController*.cs" Link="Production\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
